#!/usr/bin/env bash
# ==============================================================================
# Hyggshi OS OTA Client Tool
# Manages and executes operating system Over-The-Air (OTA) updates
# ==============================================================================
set -euo pipefail

VERSION="1.0.1"
CONFIG_FILE="/etc/hyggshi-ota.conf"
RELEASE_FILE="/etc/hyggshi-release"

# Working directory setup (safe for both root and non-root users)
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    LOCAL_RUN_DIR="/tmp/hyggshi-ota-run"
    mkdir -p "$LOCAL_RUN_DIR" 2>/dev/null || true
    chmod 1777 "$LOCAL_RUN_DIR" 2>/dev/null || true
else
    if [ -d "/tmp/hyggshi-ota-run" ] && [ -w "/tmp/hyggshi-ota-run" ]; then
        LOCAL_RUN_DIR="/tmp/hyggshi-ota-run"
    else
        LOCAL_RUN_DIR="/tmp/hyggshi-ota-run-${EUID:-$(id -u)}"
    fi
fi
mkdir -p "$LOCAL_RUN_DIR" 2>/dev/null || LOCAL_RUN_DIR="$(mktemp -d /tmp/hyggshi-ota.XXXXXX 2>/dev/null || echo "/tmp")"

# ANSI Terminal Colors
BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Default settings
DEFAULT_REPO_URL="https://raw.githubusercontent.com/Hyggshi-OS-Research-Technology/Hyggshi-OS-Releases/main/hyggshi-os-ota"
DEFAULT_CHANNEL="stable"
DEFAULT_LOG_FILE="/var/log/hyggshi-ota.log"

# Load config if present
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

OTA_REPO_URL="${OTA_REPO_URL:-$DEFAULT_REPO_URL}"
CHANNEL="${CHANNEL:-$DEFAULT_CHANNEL}"
LOG_FILE="${LOG_FILE:-$DEFAULT_LOG_FILE}"
RELEASE_FILE="${RELEASE_FILE:-/etc/hyggshi-release}"
RUN_APT_UPGRADE="${RUN_APT_UPGRADE:-true}"

# Log helper
log_msg() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    if [ -w "$(dirname "$LOG_FILE" 2>/dev/null || echo /tmp)" ]; then
        echo "$msg" >> "$LOG_FILE" 2>/dev/null || true
    fi
}

# JSON Helpers with fallback (jq -> python3 -> sed/grep)
json_val() {
    local key="$1"
    local file="$2"
    local default_val="${3:-}"

    if command -v jq >/dev/null 2>&1; then
        local res
        res=$(jq -r ".$key // empty" "$file" 2>/dev/null || true)
        if [ -n "$res" ] && [ "$res" != "null" ]; then
            echo "$res"
            return
        fi
    elif command -v python3 >/dev/null 2>&1; then
        local res
        res=$(python3 -c "
import json, sys
try:
    with open('$file', 'r', encoding='utf-8') as f:
        data = json.load(f)
    val = data.get('$key', '')
    if val is not None and val != '':
        print(val)
except:
    pass
" 2>/dev/null || true)
        if [ -n "$res" ] && [ "$res" != "null" ]; then
            echo "$res"
            return
        fi
    else
        local res
        res=$(grep -oE "\"$key\"[[:space:]]*:[[:space:]]*(\"[^\"]+\"|[0-9]+|true|false)" "$file" 2>/dev/null | head -n1 | sed -E "s/\"$key\"[[:space:]]*:[[:space:]]*\"?([^\" ]+)\"?/\1/" || true)
        if [ -n "$res" ] && [ "$res" != "null" ]; then
            echo "$res"
            return
        fi
    fi
    echo "$default_val"
}

json_array() {
    local key="$1"
    local file="$2"

    if command -v jq >/dev/null 2>&1; then
        jq -r ".$key[]? // empty" "$file" 2>/dev/null || true
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, sys
try:
    with open('$file', 'r', encoding='utf-8') as f:
        data = json.load(f)
    arr = data.get('$key', [])
    if isinstance(arr, list):
        for item in arr:
            if isinstance(item, str):
                print(item)
except:
    pass
" 2>/dev/null || true
    fi
}

json_migration_script() {
    local from_ver="$1"
    local file="$2"

    if command -v jq >/dev/null 2>&1; then
        local res
        res=$(jq -r --arg from "$from_ver" '.migrations[]? | select(.from == $from) | .script' "$file" 2>/dev/null | head -n1)
        if [ -z "$res" ] || [ "$res" = "null" ]; then
            res=$(jq -r '.migrations[0]?.script // empty' "$file" 2>/dev/null || true)
        fi
        echo "$res"
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json, sys
try:
    with open('$file', 'r', encoding='utf-8') as f:
        data = json.load(f)
    migs = data.get('migrations', [])
    chosen = ''
    for m in migs:
        if m.get('from') == '$from_ver':
            chosen = m.get('script', '')
            break
    if not chosen and len(migs) > 0:
        chosen = migs[0].get('script', '')
    if chosen:
        print(chosen)
except:
    pass
" 2>/dev/null || true
    fi
}

# Read current OS release properties directly from /etc/os-release (Standard FHS)
detect_current_de() {
    # 1. Environment variables
    local env_de="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}"
    if [ -n "$env_de" ]; then
        local env_lower=$(echo "$env_de" | tr '[:upper:]' '[:lower:]')
        case "$env_lower" in
            *xfce*) echo "xfce"; return ;;
            *gnome*) echo "gnome"; return ;;
            *plasma*|*kde*) echo "kde"; return ;;
            *cinnamon*) echo "cinnamon"; return ;;
            *mate*) echo "mate"; return ;;
            *lxqt*) echo "lxqt"; return ;;
        esac
    fi

    # 2. Running processes
    if pgrep -x "xfce4-session" >/dev/null 2>&1; then echo "xfce"; return; fi
    if pgrep -x "gnome-shell" >/dev/null 2>&1 || pgrep -x "gnome-session" >/dev/null 2>&1; then echo "gnome"; return; fi
    if pgrep -x "plasmashell" >/dev/null 2>&1 || pgrep -x "kwin_x11" >/dev/null 2>&1; then echo "kde"; return; fi
    if pgrep -x "cinnamon-session" >/dev/null 2>&1 || pgrep -x "cinnamon" >/dev/null 2>&1; then echo "cinnamon"; return; fi
    if pgrep -x "mate-session" >/dev/null 2>&1; then echo "mate"; return; fi
    if pgrep -x "lxqt-session" >/dev/null 2>&1; then echo "lxqt"; return; fi

    # 3. Alternatives / Default
    if [ -e "/etc/alternatives/x-session-manager" ]; then
        local alt_mgr
        alt_mgr=$(readlink -f /etc/alternatives/x-session-manager 2>/dev/null || true)
        case "$(echo "$alt_mgr" | tr '[:upper:]' '[:lower:]')" in
            *xfce*) echo "xfce"; return ;;
            *gnome*) echo "gnome"; return ;;
            *plasma*|*kde*) echo "kde"; return ;;
            *cinnamon*) echo "cinnamon"; return ;;
            *mate*) echo "mate"; return ;;
            *lxqt*) echo "lxqt"; return ;;
        esac
    fi

    # 4. Installed desktop binaries
    if command -v xfce4-session >/dev/null 2>&1; then echo "xfce"; return; fi
    if command -v gnome-shell >/dev/null 2>&1; then echo "gnome"; return; fi
    if command -v plasmashell >/dev/null 2>&1; then echo "kde"; return; fi
    if command -v cinnamon-session >/dev/null 2>&1; then echo "cinnamon"; return; fi
    if command -v mate-session >/dev/null 2>&1; then echo "mate"; return; fi
    if command -v lxqt-session >/dev/null 2>&1; then echo "lxqt"; return; fi

    echo "cli"
}

get_current_info() {
    CURRENT_ID="hyggshios"
    CURRENT_VERSION=""
    CURRENT_NAME="Hyggshi OS"
    CURRENT_CODENAME="Verdant Valley"
    CURRENT_DE="$(detect_current_de)"

    # 1. Primary Source: /etc/os-release (Official System ID and Version)
    if [ -f "/etc/os-release" ]; then
        # shellcheck disable=SC1091
        CURRENT_ID=$(grep -E '^ID=' /etc/os-release | head -n1 | cut -d'=' -f2 | tr -d '"'\'' ' || echo "hyggshios")
        CURRENT_VERSION=$(grep -E '^VERSION_ID=' /etc/os-release | head -n1 | cut -d'=' -f2 | tr -d '"'\'' ' || true)
        CURRENT_CODENAME=$(grep -E '^VERSION_CODENAME=' /etc/os-release | head -n1 | cut -d'=' -f2 | tr -d '"'\'' ' || echo "Verdant Valley")
        CURRENT_NAME=$(grep -E '^NAME=' /etc/os-release | head -n1 | cut -d'=' -f2 | tr -d '"' || echo "Hyggshi OS")
    fi

    # 2. Fallback to /etc/hyggshi-release only if VERSION_ID was not in /etc/os-release
    if [ -z "$CURRENT_VERSION" ] && [ -f "$RELEASE_FILE" ]; then
        # shellcheck disable=SC1090
        source "$RELEASE_FILE"
        CURRENT_ID="${ID:-$CURRENT_ID}"
        CURRENT_VERSION="${VERSION_ID:-${VERSION:-}}"
        CURRENT_CODENAME="${VERSION_CODENAME:-$CURRENT_CODENAME}"
        CURRENT_NAME="${NAME:-$CURRENT_NAME}"
    fi

    # 3. Final fallback default
    CURRENT_ID="${CURRENT_ID:-hyggshios}"
    CURRENT_VERSION="${CURRENT_VERSION:-1.4.0}"
    CURRENT_CODENAME="${CURRENT_CODENAME:-Verdant Valley}"
}

# Fetch resources (supports HTTP/HTTPS URLs, file:///, or local directories)
# Falls back: curl -> wget -> python3 urllib
FETCH_LAST_ERROR=""

fetch_resource() {
    local rel_path="$1"
    local output_path="$2"
    FETCH_LAST_ERROR=""

    if [[ "$OTA_REPO_URL" =~ ^file:// ]]; then
        local local_base="${OTA_REPO_URL#file://}"
        if [ -f "$local_base/$rel_path" ]; then
            cp -f "$local_base/$rel_path" "$output_path" 2>/dev/null && [ -s "$output_path" ] && return 0
        fi
        FETCH_LAST_ERROR="File not found in local repo: $local_base/$rel_path"
        return 1
    elif [[ -d "$OTA_REPO_URL" ]]; then
        if [ -f "$OTA_REPO_URL/$rel_path" ]; then
            cp -f "$OTA_REPO_URL/$rel_path" "$output_path" 2>/dev/null && [ -s "$output_path" ] && return 0
        fi
        FETCH_LAST_ERROR="File not found in local directory: $OTA_REPO_URL/$rel_path"
        return 1
    else
        local full_url="${OTA_REPO_URL%/}/$rel_path"
        mkdir -p "$(dirname "$output_path")" 2>/dev/null || true

        # If output file exists but is not writable, remove it first
        if [ -e "$output_path" ] && [ ! -w "$output_path" ]; then
            rm -f "$output_path" 2>/dev/null || true
        fi

        # 1. Try curl first
        if command -v curl >/dev/null 2>&1; then
            local curl_err
            curl_err=$(curl -fsSL --connect-timeout 15 --max-time 60 "$full_url" -o "$output_path" 2>&1)
            local curl_rc=$?
            if [ $curl_rc -eq 0 ] && [ -s "$output_path" ]; then
                [ "${EUID:-$(id -u)}" -eq 0 ] && chmod 666 "$output_path" 2>/dev/null || true
                return 0
            fi
            FETCH_LAST_ERROR="curl error (exit $curl_rc): $curl_err"
        fi

        # 2. Fallback: wget
        if command -v wget >/dev/null 2>&1; then
            local wget_err
            wget_err=$(wget -q --timeout=30 -O "$output_path" "$full_url" 2>&1)
            local wget_rc=$?
            if [ $wget_rc -eq 0 ] && [ -s "$output_path" ]; then
                [ "${EUID:-$(id -u)}" -eq 0 ] && chmod 666 "$output_path" 2>/dev/null || true
                return 0
            fi
            FETCH_LAST_ERROR="wget error (exit $wget_rc): $wget_err"
        fi

        # 3. Fallback: python3 urllib
        if command -v python3 >/dev/null 2>&1; then
            local py_err
            py_err=$(python3 -c "
import urllib.request, sys
try:
    urllib.request.urlretrieve('$full_url', '$output_path')
    sys.exit(0)
except Exception as e:
    sys.stderr.write(str(e))
    sys.exit(1)
" 2>&1)
            local py_rc=$?
            if [ $py_rc -eq 0 ] && [ -s "$output_path" ]; then
                [ "${EUID:-$(id -u)}" -eq 0 ] && chmod 666 "$output_path" 2>/dev/null || true
                return 0
            fi
            FETCH_LAST_ERROR="python3 urllib error (exit $py_rc): $py_err"
        fi

        return 1
    fi
}


# Semver comparison (returns 0 if v1 < v2, 1 if v1 >= v2)
semver_is_newer() {
    local v1="$1"
    local v2="$2"
    if [ "$v1" = "$v2" ]; then
        return 1
    fi
    local higher
    higher=$(printf '%s\n%s\n' "$v1" "$v2" | sort -V | tail -n1)
    if [ "$higher" = "$v2" ]; then
        return 0
    else
        return 1
    fi
}

# Print brand banner
print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  _   _                       _     _     ___  ____ "
    echo " | | | |_   _  __ _  __ _ ___| |__ (_)   / _ \/ ___|"
    echo " | |_| | | | |/ _\` |/ _\` / __| '_ \| |  | | | \___ \ "
    echo " |  _  | |_| | (_| | (_| \__ \ | | | |  | |_| |___) |"
    echo " |_| |_|\__, |\__, |\__, |___/_| |_|_|   \___/|____/ "
    echo "        |___/ |___/ |___/   OTA System Updater v$VERSION"
    echo -e "${NC}"
}

# Command: Status
cmd_status() {
    get_current_info
    echo -e "${BOLD}Hyggshi OS System Status:${NC}"
    echo -e "  • Operating System  : ${GREEN}${CURRENT_NAME}${NC}"
    echo -e "  • Desktop Env       : ${GREEN}${CURRENT_DE}${NC}"
    echo -e "  • OS ID (ID)        : ${CYAN}${CURRENT_ID}${NC}"
    echo -e "  • Current Version   : ${CYAN}${BOLD}${CURRENT_VERSION}${NC} (${CURRENT_CODENAME})"
    echo -e "  • Update Channel    : ${YELLOW}${CHANNEL}${NC}"
    echo -e "  • OTA Repository    : ${BLUE}${OTA_REPO_URL}${NC}"
    echo -e "  • Config File       : $CONFIG_FILE"
    echo -e "  • Release File      : /etc/os-release"
    echo ""
}

# Command: Check
cmd_check() {
    get_current_info
    echo -e "🔍 Connecting to Hyggshi OTA Repo [Channel: ${YELLOW}${CHANNEL}${NC}]..."

    mkdir -p "$LOCAL_RUN_DIR" 2>/dev/null || true
    local meta_tmp="$LOCAL_RUN_DIR/channel_meta.json"
    if [ -f "$meta_tmp" ] && [ ! -w "$meta_tmp" ]; then
        rm -f "$meta_tmp" 2>/dev/null || meta_tmp="$LOCAL_RUN_DIR/channel_meta_${EUID:-$(id -u)}.json"
    fi

    if ! fetch_resource "metadata/${CHANNEL}.json" "$meta_tmp"; then
        echo -e "${RED}❌ Failed to fetch channel metadata from: ${OTA_REPO_URL}/metadata/${CHANNEL}.json${NC}"
        if [ -n "${FETCH_LAST_ERROR:-}" ]; then
            echo -e "   ${YELLOW}Detail: ${FETCH_LAST_ERROR}${NC}"
        fi
        return 1
    fi

    LATEST_VERSION=$(json_val "latest_version" "$meta_tmp")
    MIN_SUPPORTED=$(json_val "min_supported_version" "$meta_tmp")
    ANNOUNCEMENT=$(json_val "announcement" "$meta_tmp")
    WARNING=$(json_val "warning" "$meta_tmp")
    MANDATORY=$(json_val "mandatory" "$meta_tmp" "false")

    if [ -z "$LATEST_VERSION" ]; then
        echo -e "${RED}❌ Invalid metadata received!${NC}"
        return 1
    fi

    echo ""
    echo -e "  • Current Version    : ${BOLD}${CURRENT_VERSION}${NC}"
    echo -e "  • Latest Version     : ${GREEN}${BOLD}${LATEST_VERSION}${NC}"

    if [ -n "$ANNOUNCEMENT" ] && [ "$ANNOUNCEMENT" != "null" ]; then
        echo -e "  • Announcement       : ${CYAN}${ANNOUNCEMENT}${NC}"
    fi

    if [ -n "$WARNING" ] && [ "$WARNING" != "null" ]; then
        echo -e "  • ${YELLOW}Warning: ${WARNING}${NC}"
    fi

    # Check semver comparison
    if semver_is_newer "$CURRENT_VERSION" "$LATEST_VERSION"; then
        echo ""
        echo -e "${GREEN}${BOLD}✨ New update available: Hyggshi OS $LATEST_VERSION!${NC}"
        
        # Fetch release manifest for changelog
        local rel_manifest="$LOCAL_RUN_DIR/release_${LATEST_VERSION}.json"
        if [ -f "$rel_manifest" ] && [ ! -w "$rel_manifest" ]; then
            rm -f "$rel_manifest" 2>/dev/null || rel_manifest="$LOCAL_RUN_DIR/release_${LATEST_VERSION}_${EUID:-$(id -u)}.json"
        fi
        if fetch_resource "releases/${LATEST_VERSION}/release.json" "$rel_manifest"; then
            local codename
            codename=$(json_val "codename" "$rel_manifest")
            echo -e "  • Codename: ${BOLD}${codename}${NC}"
            echo -e "  • Highlights:"
            json_array "changelog" "$rel_manifest" | while read -r line; do
                if [ -n "$line" ]; then
                    echo -e "    ${GREEN}+${NC} $line"
                fi
            done
        fi

        echo ""
        echo -e "To perform system upgrade, run:"
        echo -e "  ${BOLD}sudo hyggshi-ota upgrade${NC}"
        return 0
    else
        echo ""
        echo -e "${GREEN}✔ Your Hyggshi OS system is up to date (${CURRENT_VERSION}).${NC}"
        return 0
    fi
}

# Command: Upgrade
cmd_upgrade() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${RED}❌ Error: Superuser privileges (root or sudo) required for system upgrade!${NC}"
        exit 1
    fi

    get_current_info
    echo -e "🚀 Starting Hyggshi OS OTA upgrade process..."
    echo -e "  • Current Version  : ${BOLD}${CURRENT_VERSION}${NC}"
    echo -e "  • Desktop Env      : ${GREEN}${CURRENT_DE}${NC}"
    echo -e "  • Target Channel   : ${YELLOW}${CHANNEL}${NC}"

    mkdir -p "$LOCAL_RUN_DIR" 2>/dev/null || true
    local meta_tmp="$LOCAL_RUN_DIR/channel_meta.json"
    if [ -f "$meta_tmp" ] && [ ! -w "$meta_tmp" ]; then
        rm -f "$meta_tmp" 2>/dev/null || meta_tmp="$LOCAL_RUN_DIR/channel_meta_${EUID:-$(id -u)}.json"
    fi

    if ! fetch_resource "metadata/${CHANNEL}.json" "$meta_tmp"; then
        echo -e "${RED}❌ Failed to fetch metadata from OTA repository.${NC}"
        if [ -n "${FETCH_LAST_ERROR:-}" ]; then
            echo -e "   ${YELLOW}Detail: ${FETCH_LAST_ERROR}${NC}"
        fi
        exit 1
    fi

    local target_ver
    target_ver=$(json_val "latest_version" "$meta_tmp")

    if [ "$FORCE" != "true" ] && ! semver_is_newer "$CURRENT_VERSION" "$target_ver"; then
        echo -e "${GREEN}✔ System is already on latest version ($CURRENT_VERSION). No upgrade needed.${NC}"
        echo -e "Use ${BOLD}--force${NC} flag if you wish to reinstall this release."
        exit 0
    fi

    echo -e "🎯 Target Version  : ${GREEN}${BOLD}${target_ver}${NC}"

    # Fetch release manifest
    local rel_manifest="$LOCAL_RUN_DIR/release_${target_ver}.json"
    if ! fetch_resource "releases/${target_ver}/release.json" "$rel_manifest" 2>/dev/null; then
        echo -e "${RED}❌ Release manifest (release.json) not found for version $target_ver!${NC}"
        exit 1
    fi

    local target_codename
    target_codename=$(json_val "codename" "$rel_manifest" "Update")
    local requires_reboot
    requires_reboot=$(json_val "requires_reboot" "$rel_manifest" "false")

    echo ""
    echo -e "${CYAN}${BOLD}📋 Release Summary for Hyggshi OS ${target_ver} (${target_codename}):${NC}"
    json_array "changelog" "$rel_manifest" | while read -r line; do
        if [ -n "$line" ]; then
            echo -e "  * $line"
        fi
    done
    echo ""

    if [ "$ASSUME_YES" != "true" ]; then
        read -r -p "Are you sure you want to proceed with upgrading to Hyggshi OS ${target_ver}? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[yY]([eE][sS])?$ ]]; then
            echo -e "${YELLOW}Upgrade canceled.${NC}"
            exit 0
        fi
    fi

    log_msg "Starting upgrade from $CURRENT_VERSION to $target_ver..."

    # Step 1: Execute Pre-upgrade script if defined
    local pre_script_rel
    pre_script_rel=$(json_val "pre_upgrade_script" "$rel_manifest")
    if [ -n "$pre_script_rel" ] && [ "$pre_script_rel" != "null" ]; then
        echo -e "\n${BOLD}[1/5] Running pre-upgrade validation checks...${NC}"
        local pre_script_local="$LOCAL_RUN_DIR/pre-upgrade.sh"
        if fetch_resource "releases/${target_ver}/$pre_script_rel" "$pre_script_local" 2>/dev/null; then
            chmod +x "$pre_script_local"
            "$pre_script_local"
        fi
    else
        echo -e "\n${BOLD}[1/5] Skipping pre-upgrade checks (not required).${NC}"
    fi

    # Step 2: Locate and execute Migration script
    echo -e "\n${BOLD}[2/5] Locating and executing version migration script...${NC}"
    local migration_script_rel
    migration_script_rel=$(json_migration_script "$CURRENT_VERSION" "$rel_manifest")

    if [ -n "$migration_script_rel" ] && [ "$migration_script_rel" != "null" ]; then
        echo -e "  → Executing migration: ${migration_script_rel}"
        local mig_script_local="$LOCAL_RUN_DIR/migration.sh"
        if fetch_resource "releases/${target_ver}/$migration_script_rel" "$mig_script_local" 2>/dev/null; then
            chmod +x "$mig_script_local"
            "$mig_script_local"
        fi
    else
        echo "  → No migration script required for this transition."
    fi

    # Step 3: Upgrade APT system packages
    echo -e "\n${BOLD}[3/5] Synchronizing repositories and upgrading system packages (APT)...${NC}"
    if [ "$RUN_APT_UPGRADE" = "true" ]; then
        export DEBIAN_FRONTEND=noninteractive
        echo "  → Updating package index (apt-get update)..."
        apt-get update -qq || true
        echo "  → Upgrading core packages..."
        apt-get upgrade -y -qq 2>/dev/null || true
    else
        echo "  → Skipping APT package upgrade (RUN_APT_UPGRADE=false)."
    fi

    # Step 3.5: Execute HCL release configuration via hcl_parser.py if available
    local hcl_rel
    hcl_rel=$(json_val "hcl_config" "$rel_manifest")
    if [ -z "$hcl_rel" ] || [ "$hcl_rel" = "null" ]; then
        hcl_rel="scripts/config/config.ini"
    fi

    local hcl_local="$LOCAL_RUN_DIR/config.ini"
    if fetch_resource "releases/${target_ver}/$hcl_rel" "$hcl_local" 2>/dev/null; then
        local hcl_parser_bin=""
        if [ -x "/usr/local/bin/hcl_parser.py" ]; then
            hcl_parser_bin="/usr/local/bin/hcl_parser.py"
        elif [ -f "$(dirname "$0")/hcl_parser.py" ]; then
            hcl_parser_bin="$(dirname "$0")/hcl_parser.py"
        fi

        if [ -n "$hcl_parser_bin" ]; then
            echo -e "\n${BOLD}[HCL] Invoking HCL Parser (hcl_parser.py) to execute release components...${NC}"
            python3 "$hcl_parser_bin" --config "$hcl_local" --base-dir "$LOCAL_RUN_DIR" --apply || true
        fi
    fi

    # Step 4: Execute Post-upgrade script if defined
    local post_script_rel
    post_script_rel=$(json_val "post_upgrade_script" "$rel_manifest")
    if [ -n "$post_script_rel" ] && [ "$post_script_rel" != "null" ]; then
        echo -e "\n${BOLD}[4/5] Running post-upgrade finalizing script...${NC}"
        local post_script_local="$LOCAL_RUN_DIR/post-upgrade.sh"
        if fetch_resource "releases/${target_ver}/$post_script_rel" "$post_script_local" 2>/dev/null; then
            chmod +x "$post_script_local"
            "$post_script_local"
        fi
    else
        echo -e "\n${BOLD}[4/5] Skipping post-upgrade tasks.${NC}"
    fi

    # Step 5: Safely update version in /etc/os-release PRESERVING ALL existing fields
    echo -e "\n${BOLD}[5/5] Updating OS release identification metadata...${NC}"
    local build_today
    build_today=$(date '+%Y%m%d')

    # Remove symlink if /etc/hyggshi-release points to /etc/os-release to avoid accidental overwrite
    if [ -L "$RELEASE_FILE" ]; then
        rm -f "$RELEASE_FILE"
    fi

    # Update in-place in /etc/os-release preserving all comments, ID_LIKE, HYGGSHI_BASE_*, LOGO, etc.
    if [ -f "/etc/os-release" ]; then
        sed -i -E "s/^VERSION_ID=.*/VERSION_ID=\"${target_ver}\"/" /etc/os-release
        sed -i -E "s/^VERSION=.*/VERSION=\"${target_ver} (${target_codename}) (Debian trixie)\"/" /etc/os-release
        sed -i -E "s/^PRETTY_NAME=.*/PRETTY_NAME=\"Hyggshi OS ${target_ver} ${target_codename} Debian Edition\"/" /etc/os-release
        sed -i -E "s/^NAME=.*/NAME=\"Hyggshi OS ${target_ver} ${target_codename} Debian Edition\"/" /etc/os-release
        sed -i -E "s/^VERSION_CODENAME=.*/VERSION_CODENAME=\"${target_codename}\"/" /etc/os-release

        # Ensure critical Hyggshi distro identity fields exist without modifying others
        if ! grep -q '^ID_LIKE=' /etc/os-release; then
            echo "ID_LIKE=debian" >> /etc/os-release
        fi
        if ! grep -q '^HYGGSHI_BASE_DISTRO=' /etc/os-release; then
            echo "HYGGSHI_BASE_DISTRO=debian" >> /etc/os-release
        fi
        if ! grep -q '^HYGGSHI_BASE_CODENAME=' /etc/os-release; then
            echo "HYGGSHI_BASE_CODENAME=trixie" >> /etc/os-release
        fi
        if ! grep -q '^LOGO=' /etc/os-release; then
            echo "LOGO=distributor-logo" >> /etc/os-release
        fi

        echo "  ✔ Successfully updated /etc/os-release (all original distribution fields preserved)!"
    fi

    # Record OTA release state in a dedicated separate metadata file (never overwrite /etc/os-release)
    cat <<EOF > /etc/hyggshi-ota-state.conf
LAST_UPGRADE_DATE="${build_today}"
CURRENT_VERSION="${target_ver}"
CURRENT_CODENAME="${target_codename}"
CHANNEL="${CHANNEL}"
EOF

    log_msg "Upgrade completed successfully from $CURRENT_VERSION -> $target_ver."

    echo ""
    echo -e "${GREEN}${BOLD}🎉 CONGRATULATIONS! SYSTEM SUCCESSFULLY UPGRADED TO HYGGSHI OS ${target_ver} (${target_codename})!${NC}"
    if [ "$requires_reboot" = "true" ]; then
        echo -e "${YELLOW}${BOLD}⚠ A system restart is recommended to complete the upgrade.${NC}"
        echo -e "Reboot now: ${BOLD}sudo reboot${NC}"
    fi
    echo ""
}

# Command: Switch Channel
cmd_channel() {
    local target_ch="${1:-}"
    if [ -z "$target_ch" ]; then
        echo -e "Current Channel : ${YELLOW}${BOLD}${CHANNEL}${NC}"
        echo "Available channels: stable, beta, testing"
        echo "Usage: sudo hyggshi-ota channel <stable|beta|testing>"
        return 0
    fi

    if [[ ! "$target_ch" =~ ^(stable|beta|testing)$ ]]; then
        echo -e "${RED}❌ Invalid channel: $target_ch. Allowed: stable, beta, testing.${NC}"
        exit 1
    fi

    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${RED}❌ Root privileges required to change update channel in $CONFIG_FILE!${NC}"
        exit 1
    fi

    mkdir -p "$(dirname "$CONFIG_FILE")"
    if [ -f "$CONFIG_FILE" ]; then
        sed -i -E "s/^CHANNEL=.*/CHANNEL=\"$target_ch\"/" "$CONFIG_FILE"
    else
        echo "CHANNEL=\"$target_ch\"" > "$CONFIG_FILE"
    fi

    echo -e "${GREEN}✔ Successfully switched OTA channel to: ${BOLD}$target_ch${NC}"
    CHANNEL="$target_ch"
    cmd_check
}

# Command: Log
cmd_log() {
    if [ -f "$LOG_FILE" ]; then
        echo -e "${BOLD}Hyggshi OTA Update Log ($LOG_FILE):${NC}"
        tail -n 25 "$LOG_FILE"
    else
        echo -e "${YELLOW}No log records found at $LOG_FILE.${NC}"
    fi
}

# Command: Help
cmd_help() {
    print_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo "  hyggshi-ota [command] [options]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo "  status               Show current OS version and OTA status"
    echo "  check                Check for new updates from OTA repository"
    echo "  upgrade              Perform full system upgrade (pre-check, migration, apt)"
    echo "  channel [name]       Display or switch release channel (stable, beta, testing)"
    echo "  log                  Display recent OTA update history"
    echo "  help                 Display this help guide"
    echo ""
    echo -e "${BOLD}OPTIONS:${NC}"
    echo "  --repo-url <URL>     Override OTA repository base URL (HTTP or local path)"
    echo "  --channel <channel>  Override release channel"
    echo "  -y, --yes            Assume yes to all upgrade prompts"
    echo "  -f, --force          Force upgrade even if already on the latest version"
    echo ""
}

# Parse command-line arguments
ACTION="status"
ASSUME_YES="false"
FORCE="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        status|check|upgrade|channel|log|help)
            ACTION="$1"
            shift
            if [ "$ACTION" = "channel" ] && [ -n "${1:-}" ] && [[ ! "$1" =~ ^-- ]]; then
                NEW_CHANNEL="$1"
                shift
            fi
            ;;
        --repo-url)
            OTA_REPO_URL="$2"
            shift 2
            ;;
        --channel)
            CHANNEL="$2"
            shift 2
            ;;
        -y|--yes)
            ASSUME_YES="true"
            shift
            ;;
        -f|--force)
            FORCE="true"
            shift
            ;;
        -h|--help)
            ACTION="help"
            shift
            ;;
        *)
            echo -e "${RED}Unknown argument: $1${NC}"
            cmd_help
            exit 1
            ;;
    esac
done

case "$ACTION" in
    status)  cmd_status ;;
    check)   cmd_check ;;
    upgrade) cmd_upgrade ;;
    channel) cmd_channel "${NEW_CHANNEL:-}" ;;
    log)     cmd_log ;;
    help)    cmd_help ;;
esac
